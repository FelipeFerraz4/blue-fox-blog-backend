###############################################################################
# Blue Fox Blog - Configurações de Desenvolvimento (NestJS + Prisma)
###############################################################################

# Subir com docker-compose:
# docker compose -f docker-compose.yml -f docker-compose.dev.yaml --env-file .env.dev up --build

# Ambiente
NODE_ENV=development

# Servidor NestJS
BACKEND_PORT=8081
PORT=8081

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_db?schema=public

# Keycloak / OAuth2 Resource Server
KEYCLOAK_ISSUER_URI=http://localhost:8080/auth/realms/Blue_Fox_Group

# Swagger
SWAGGER_ENABLED=true

# Logs
LOG_LEVEL=debug
