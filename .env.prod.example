###############################################################################
# Blue Fox Blog - Configurações de Produção (NestJS + Prisma)
###############################################################################

# Subir com docker-compose:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Baixa os containers:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod down

NODE_ENV=production

PORT=8081

DB_HOST=postgres
DB_PORT=5432
DB_NAME=blog_db
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@postgres:5432/blog_db?schema=public

KEYCLOAK_ISSUER_URI=https://sso.bluefoxglobalgroup.com/auth/realms/blue-fox-global-group
SWAGGER_ENABLED=false
LOG_LEVEL=info
